# =============================================================================
#  .env.example — BreakMate Release Configuration Template
# =============================================================================
#
#  Copy this file to `.env.release` and fill in your actual settings.
#  The release scripts (create_dmg.sh, publish_release.sh) will automatically
#  load their configuration from `.env.release`.
#
# =============================================================================

# ── App Identity ──────────────────────────────────────────────────────────────
# The display name of the app (used in DMG naming, release titles, and logs)
APP_NAME="BreakMate"

# Flutter build flavor (e.g., prod, dev). Leave empty if not using flavors.
APP_FLAVOR="prod"

# ── GitHub Configuration ──────────────────────────────────────────────────────
# The repository where the release DMG and tag will be uploaded
# Format: <owner>/<repo>
RELEASE_GITHUB_REPO="your-github-username/your-app-repo"

# The repository that hosts the appcast.xml file (for Sparkle updates)
# Often the same as RELEASE_GITHUB_REPO, but can be a dedicated updates repository.
# Format: <owner>/<repo>
APPCAST_GITHUB_REPO="bijithpn/standup"

# Git branch to commit and push changes of appcast.xml to
GIT_BRANCH="main"

# ── Paths (Relative to project root) ──────────────────────────────────────────
# Subpath to the built macOS application package
APP_BUILD_SUBPATH="build/macos/Build/Products/Release-prod"

# Directory where the installer DMG will be outputted
DMG_OUTPUT_SUBDIR="release_dmg"

# Subpath to the appcast.xml feed file
APPCAST_SUBPATH="appcast.xml"

# ── Sparkle Signing (Ed25519) ─────────────────────────────────────────────────
# Path to your Ed25519 private key (.pem) file.
# Leave blank to fallback to macOS Keychain auto-detection.
# (Recommended: set this in your shell instead: export SPARKLE_PRIVATE_KEY="/path/to/key")
SPARKLE_PRIVATE_KEY=""

# Default path where the keys generator script exports the private key.
# This fallback is used if SPARKLE_PRIVATE_KEY is left empty.
DEFAULT_SPARKLE_PRIVATE_KEY="$HOME/secrets/breakmate_sparkle_private.pem"
