platform :osx, '11.0'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
  'Debug-dev' => :debug,
  'Profile-dev' => :release,
  'Release-dev' => :release,
  'Debug-prod' => :debug,
  'Profile-prod' => :release,
  'Release-prod' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  pod 'Sparkle', '~> 2.6'

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  debug_engine_dir = File.join(flutter_root, 'bin', 'cache', 'artifacts', 'engine', 'darwin-x64', 'FlutterMacOS.xcframework', 'macos-arm64_x86_64')
  release_engine_dir = File.join(flutter_root, 'bin', 'cache', 'artifacts', 'engine', 'darwin-x64-release', 'FlutterMacOS.xcframework', 'macos-arm64_x86_64')
  ephemeral_dir = File.expand_path(File.join('..', 'Flutter', 'ephemeral'), __FILE__)

  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['MACOSX_DEPLOYMENT_TARGET'] = '11.0'
      engine_dir = config.name.downcase.include?('debug') ? debug_engine_dir : release_engine_dir
      config.build_settings['FRAMEWORK_SEARCH_PATHS'] = [
        '$(inherited)',
        "\"#{engine_dir}\"",
        "\"#{ephemeral_dir}\"",
        '"$(SDKROOT)/System/Library/Frameworks"'
      ]
      config.build_settings['OTHER_LDFLAGS'] = '$(inherited) -framework FlutterMacOS'
    end
  end

  target_support_dir = File.join(__dir__, 'Pods', 'Target Support Files')
  if Dir.exist?(target_support_dir)
    Dir.glob(File.join(target_support_dir, '**', '*.xcconfig')).each do |xcconfig_file|
      next if xcconfig_file.include?('Pods-Runner')
      content = File.read(xcconfig_file)
      engine_dir = xcconfig_file.downcase.include?('debug') ? debug_engine_dir : release_engine_dir
      extra = "\nFRAMEWORK_SEARCH_PATHS = $(inherited) \"#{engine_dir}\" \"#{ephemeral_dir}\" \"$(SDKROOT)/System/Library/Frameworks\"\nOTHER_LDFLAGS = $(inherited) -framework FlutterMacOS\n"
      File.write(xcconfig_file, content + extra)
    end
  end
end
